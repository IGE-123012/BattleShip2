package battleship;

        /**
        * Classe de testes para a classe Game (JUnit 5).
        * Autor: ${user.name}
        * Data: 2026-04-29
        * Complexidade Ciclomática (CC):
        * - constructor: 1
        * - jsonShots(List): 3
        * - readEnemyFire(Scanner): 5
        * - fireShots(List): 3
        * - fireSingleShot(IPosition, boolean): 6
        * - repeatedShot(IPosition): 3
        */

        import org.junit.jupiter.api.Test;
        import org.junit.jupiter.api.BeforeEach;
        import org.junit.jupiter.api.AfterEach;
        import static org.junit.jupiter.api.Assertions.*;

        import java.util.*;

        public class GameTest {

        private Game game;
        private IFleet dummyFleet;

        // ==========================================
        // Setup and Teardown
        // ==========================================

        @BeforeEach
        void setUp() {
        // Criando uma implementação dummy de IFleet para testes isolados
        dummyFleet = new IFleet() {
        @Override public List<IShip> getShips() { return new ArrayList<>(); }
    @Override public List<IShip> getFloatingShips() { return new ArrayList<>(); }
        @Override public List<IShip> getSunkShips() { return new ArrayList<>(); }
            @Override public IShip shipAt(IPosition pos) { return null; }
            @Override public void addShip(IShip ship) { /* Implementação vazia */ }
            };

            game = new Game(dummyFleet);
            }

            @AfterEach
            void tearDown() {
            game = null;
            dummyFleet = null;
            }

            // ==========================================
            // Testes: Construtor
            // ==========================================

            @Test
            void Game1() {
            assertAll("Inicialização do Construtor Game",
            () -> assertNotNull(game.getMyFleet(), "Erro: esperado myFleet inicializado, mas retornou null"),
            () -> assertNotNull(game.getAlienMoves(), "Erro: esperado alienMoves inicializado, mas retornou null"),
            () -> assertEquals(0, game.getInvalidShots(), "Erro: contagem inicial de tiros inválidos deveria ser 0"),
            () -> assertEquals(0, game.getHits(), "Erro: contagem inicial de acertos deveria ser 0")
            );
            }

            // ==========================================
            // Testes: fireSingleShot (CC = 6)
            // ==========================================

            @Test
            void fireSingleShot1() {
            IPosition outOfBoundsPos = createDummyPosition(15, 15, false);
            ShotResult result = game.fireSingleShot(outOfBoundsPos, false);

            assertAll("Verificação de tiro fora dos limites",
            () -> assertFalse(result.isValid(), "Erro: esperado isValid falso para tiro fora do tabuleiro"),
            () -> assertEquals(1, game.getInvalidShots(), "Erro: contador de tiros inválidos deveria incrementar para 1")
            );
            }

            @Test
            void fireSingleShot2() {
            IPosition validPos = createDummyPosition(5, 5, true);
            ShotResult result = game.fireSingleShot(validPos, true);

            assertAll("Verificação de tiro repetido (flag direta)",
            () -> assertTrue(result.isValid(), "Erro: esperado isValid verdadeiro"),
            () -> assertTrue(result.isRepeated(), "Erro: esperado isRepeated verdadeiro"),
            () -> assertEquals(1, game.getRepeatedShots(), "Erro: contador de tiros repetidos deveria incrementar para 1")
            );
            }

            @Test
            void fireSingleShot3() {
            IPosition validPos = createDummyPosition(2, 2, true);
            game.getAlienMoves().add(new DummyMove(validPos));

            ShotResult result = game.fireSingleShot(validPos, false);

            assertTrue(result.isRepeated(), "Erro: esperado isRepeated verdadeiro pois a posição já está nos movimentos");
            }

            @Test
            void fireSingleShot4() {
            IPosition validPos = createDummyPosition(1, 1, true);
            ShotResult result = game.fireSingleShot(validPos, false);

            assertAll("Verificação de tiro na água",
            () -> assertTrue(result.isValid(), "Erro: esperado isValid verdadeiro"),
            () -> assertFalse(result.isRepeated(), "Erro: esperado isRepeated falso"),
            () -> assertNull(result.getShip(), "Erro: esperado ship null para tiro na água"),
            () -> assertEquals(0, game.getHits(), "Erro: contador de acertos deve continuar 0")
            );
            }

            @Test
            void fireSingleShot5() {
            IPosition validPos = createDummyPosition(3, 3, true);
            IShip dummyShip = createDummyShip(true); // Navio ainda flutuando

            Game gameWithShip = new Game(new DummyFleetWithShip(validPos, dummyShip));
            ShotResult result = gameWithShip.fireSingleShot(validPos, false);

            assertAll("Verificação de acerto sem afundar",
            () -> assertTrue(result.isValid(), "Erro: esperado isValid verdadeiro"),
            () -> assertNotNull(result.getShip(), "Erro: esperado retorno do navio atingido"),
            () -> assertFalse(result.isSunk(), "Erro: esperado isSunk falso"),
            () -> assertEquals(1, gameWithShip.getHits(), "Erro: contador de acertos deveria ir para 1"),
            () -> assertEquals(0, gameWithShip.getSunkShips(), "Erro: contador de navios afundados deve continuar 0")
            );
            }

            @Test
            void fireSingleShot6() {
            IPosition validPos = createDummyPosition(4, 4, true);
            IShip dummyShip = createDummyShip(false); // Simula que o navio afundou neste tiro

            Game gameWithShip = new Game(new DummyFleetWithShip(validPos, dummyShip));
            ShotResult result = gameWithShip.fireSingleShot(validPos, false);

            assertAll("Verificação de acerto e afundamento",
            () -> assertTrue(result.isSunk(), "Erro: esperado isSunk verdadeiro"),
            () -> assertEquals(1, gameWithShip.getSunkShips(), "Erro: contador de navios afundados deveria ir para 1")
            );
            }

            // ==========================================
            // Classes Auxiliares e Dummies
            // ==========================================

            private IPosition createDummyPosition(int row, int col, boolean isInside) {
            return new IPosition() {
            @Override public int getRow() { return row; }
            @Override public int getColumn() { return col; }
            @Override public char getClassicRow() { return (char)('A' + row); }
            @Override public int getClassicColumn() { return col + 1; }
            @Override public boolean isInside() { return isInside; }
            @Override public boolean isAdjacentTo(IPosition pos) { return false; }
            @Override public boolean equals(Object obj) { return this == obj; }
            };
            }

            private IShip createDummyShip(boolean floating) {
            return new IShip() {
            @Override public boolean stillFloating() { return floating; }
            @Override public void shoot(IPosition pos) { }
            @Override public List<IPosition> getPositions() { return new ArrayList<>(); }
                @Override public List<IPosition> getAdjacentPositions() { return new ArrayList<>(); }
                    @Override public String getCategory() { return "DummyCategory"; }
                    };
                    }

                    class DummyMove implements IMove {
                    private List<IPosition> shots = new ArrayList<>();
                        public DummyMove(IPosition pos) { this.shots.add(pos); }
                        @Override public List<IPosition> getShots() { return shots; }
                            @Override public List<ShotResult> getResults() { return new ArrayList<>(); }
                                @Override public int getNumber() { return 1; }
                                }

                                class DummyFleetWithShip implements IFleet {
                                private IPosition pos;
                                private IShip ship;
                                public DummyFleetWithShip(IPosition pos, IShip ship) { this.pos = pos; this.ship = ship; }
                                @Override public IShip shipAt(IPosition checkPos) { return pos.equals(checkPos) ? ship : null; }
                                @Override public List<IShip> getShips() { return new ArrayList<>(); }
                                    @Override public List<IShip> getFloatingShips() { return new ArrayList<>(); }
                                        @Override public List<IShip> getSunkShips() { return new ArrayList<>(); }
                                            @Override public void addShip(IShip ship) { }
                                            }
                                            }